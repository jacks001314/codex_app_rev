{
  "$schema_note": "Ordered classification rules for Codex desktop 26.1013.4894.0. First matching rule wins. Patterns match the chunk basename with the content hash removed.",
  "version_target": "26.1013.40934",
  "shared_excludes": {
    "note": "Shared runtime, vendored library and bulk-data chunks. Never copied into a module; recorded as external refs.",
    "patterns": [
      "^app-initial-",
      "^app-primary-",
      "^app-shared-",
      "^rolldown-runtime-",
      "^register-",
      "^runtime\\.worker-",
      "^chunk-",
      "^index-[A-Za-z0-9]{8}-",
      "^[a-z]{2,3}(-[A-Z]{2})?-[0-9a-f]{8,20}\\.(js|css)$",
      "^(mapbox-gl|three\\.module|cytoscape\\.esm|katex|lowlight|mathlive\\.min|jsxgraph|drei|pdf|workbook|spreadsheet|presentation|viewer|dotnet\\.runtime|es6|cpp|wasm|render|ValdiRuntimeProvider|RealtimeEngineBuilder)-",
      "^(mermaid\\.core|dagre|rough\\.esm|chartjs-plugin-zoom\\.esm|silero-vad)-",
      "^(abnf|architecture|c4|class|er|flow|gantt|gitGraph|info|ishikawa|journey|kanban|mindmap|peg|pie|quadrant|railroad|requirement|sankey|sequence|state|swimlanes|timeline|venn|wardley|xychart)(Diagram|Definition)?-",
      "^visualization-[0-9a-f]{8,20}\\.(js|css)$",
      "^(asset-urls|type|examples|model)-[0-9a-f]{8,20}\\.(js|css)$"
    ],
    "max_closure_bytes": 250000
  },
  "rules": [
    {
      "module": "settings",
      "subdir": "search-index",
      "pattern": "^_virtual_settings-search-documents"
    },
    {
      "module": "spaces",
      "subdir": "sidebar",
      "pattern": "^space-sidebar$"
    },
    {
      "module": "spaces",
      "subdir": "pages",
      "pattern": "^space-|^spaces-|^select-space|^create-space"
    },
    {
      "module": "voice",
      "subdir": "voice",
      "pattern": "^realtime-|^voice-|^speech$|^pronunciation$|^silero-vad$|^recording-control$|^wingman-voice|^start-voice$|^audio$"
    },
    {
      "module": "writing",
      "subdir": "writing",
      "pattern": "^writing-|^chatgpt-writing"
    },
    {
      "module": "aeon",
      "subdir": "dot",
      "pattern": "^(aeon-|orbit-conversation|orbit-introduction|dot-onboarding|dot-doJTctYY|start-aeon|record-aeon)"
    },
    {
      "module": "personalized",
      "subdir": "pages",
      "pattern": "^appgen-|^personalized-|^personal-apps$|^shared-snapshot-|^shared-codex-snapshot$|^template-|^templates$"
    },
    {
      "module": "personalized",
      "subdir": "connect",
      "pattern": "^app-connect-|^app-account-picker$|^app-connection$|^sites-|^site-"
    },
    {
      "module": "tasks",
      "subdir": "tasks",
      "pattern": "^tasks$|^task-|^scheduled-goal-|^schedule-|^run-now$|^run-results"
    },
    {
      "module": "chronicle",
      "subdir": "chronicle",
      "pattern": "^chronicle-"
    },
    {
      "module": "codex-micro",
      "subdir": "codex-micro",
      "pattern": "^codex-micro-"
    },
    {
      "module": "chatgpt-surfaces",
      "subdir": "chatgpt",
      "pattern": "^chatgpt-|^codex-home-announcements$|^codex-app-home-beacon|^whats-new-|^announcement"
    },
    {
      "module": "settings",
      "subdir": "shell",
      "pattern": "^(settings|settings-page|settings-route-state|settings-host-dropdown|settings-command-menu-section-items|settings-loading-row|settings-row-disclosure|settings-external-section|settings-plugin-selection|use-visible-settings-sections)$|^settings-"
    },
    {
      "module": "settings",
      "subdir": "onboarding",
      "pattern": "^(onboarding-page|onboarding-entrypoint|onboarding-login-content|onboarding-interactive-dynamic-tools|onboarding-mail-provider|login-route|security-route|wallet-onboarding-announcement-content|wallet-onboarding-announcement-modal|worktree-onboarding-banner-controller|worktree-onboarding-state|chatgpt-onboarding-dialog|onboarding-|migration-onboarding|conversational-onboarding|plus-onboarding|subscription-onboarding|cloud-aeon-onboarding)"
    },
    {
      "module": "settings",
      "subdir": "pages",
      "pattern": "^profile-[0-9a-f]{8,16}$|^data-controls-|^billing-analytics-|^skills-page-|^plugins-settings|^settings-plugin-controls"
    },
    {
      "module": "settings",
      "subdir": "shell",
      "pattern": "^settings-external-section-"
    },
    {
      "module": "settings",
      "subdir": "pages",
      "pattern": "settings|^review-preferences-model|^cloud-preferences|^analytics-|^connector-settings-redirect|^pets-settings-route|^code-review-|^keyboard-shortcuts-|^agreements-|^appshots-|^appearance-|^billing-|^member-|^team-settings|^trusted-contact-|^remote-connections-|^worktrees-|^safety-|^security-|^time-management-|^device-storage-|^configuration-panel|^panel-|^file-type-handlers-|^page-9ec3bf63ff1f"
    },
    {
      "module": "composer",
      "subdir": "queue",
      "pattern": "^queued-message-list|^queue-|^message-queue"
    },
    {
      "module": "composer",
      "subdir": "quick-chat",
      "pattern": "^quick-chat|^content-quick-chat-overlay|^avatar-overlay-quick-chat-bar|^local-conversation-quick-chat-overlay|^global-dictation-page|^dictation-"
    },
    {
      "module": "composer",
      "subdir": "core",
      "pattern": "composer|^primary-composer-at-mention-list|^browser-composer-disclaimer|^use-chatgpt-composer-controller|^right-panel-composer-overlay|^unified-floating-composer|^home-composer-mode-toggle"
    },
    {
      "module": "side-panel",
      "subdir": "subagents",
      "pattern": "subagent"
    },
    {
      "module": "side-panel",
      "subdir": "terminal",
      "pattern": "^terminal-panel|^xterm-output-panel|^xterm-window-zoom|background-terminal|^exec-shell-container|^terminal-workspace-warning-state"
    },
    {
      "module": "side-panel",
      "subdir": "previews",
      "pattern": "^PopcornElectron|^artifact-tab-content|^artifact-source-bootstrap|^file-editor-theme"
    },
    {
      "module": "side-panel",
      "subdir": "previews",
      "pattern": "^pdf-preview-panel|^docx-preview-panel|^notebook-preview-panel|^cloud-browser-|^text-file-editor|^file-editor-theme|^artifact-tab-content|^artifact-source-bootstrap|^lazy-presentation-panel|^presentation-panel"
    },
    {
      "module": "side-panel",
      "subdir": "tabs",
      "pattern": "side-panel|-panel-tab|^panel-visibility|^control-panel|^new-thread-panel-page|^thread-panel-|^toggle-thread-summary-panel|^thread-goal-|^thread-pull-request-|^open-thread-pull-request|^open-pull-request|^open-artifact|^open-text-file|^open-automation|^open-sources|^open-local-conversation|^mcp-extension-thread|^thread-mcp-app|^thread-right-panel-state|^automation-side-panel|^cloud-automation-detail-panel|^local-conversation-summary-panel|^thread-summary-panel|^summary-panel-"
    },
    {
      "module": "left-nav",
      "subdir": "sidebar",
      "pattern": "^sidebar-"
    },
    {
      "module": "left-nav",
      "subdir": "library",
      "pattern": "^library-|^unified-library-page|^selectable-library-item"
    },
    {
      "module": "workspace",
      "subdir": "pages",
      "pattern": "^select-workspace-page|^workspace-|^remote-workspace-root-dialog|^new-thread-panel-page|^hotkey-window-home-page|^home-page"
    },
    {
      "module": "conversation",
      "subdir": "nav-rail",
      "pattern": "^thread-user-message-navigation-rail-app"
    },
    {
      "module": "conversation",
      "subdir": "scroll",
      "pattern": "^thread-scroll-|^thread-virtualizer|^thread-context|^thread-tab-route-checkpoint|^thread-response-space-controller"
    },
    {
      "module": "conversation",
      "subdir": "turn",
      "pattern": "^local-conversation-turn|^local-conversation-thread-turn-entries|^artifact-originating-turn|^revision-review-unavailable-message|^local-conversation-stream-role-product-event"
    },
    {
      "module": "conversation",
      "subdir": "thread",
      "pattern": "^local-conversation-thread|^thread-overflow-menu|^thread-pin-shortcut-bridge|^thread-usage-breakdown|^local-conversation-git-actions|^local-conversation-plan-model|^local-conversation-webmcp-tools-model|^local-conversation-background-agent|^open-local-conversation-background-agent|^use-conversation-diff-comments"
    },
    {
      "module": "conversation",
      "subdir": "markdown",
      "pattern": "^conversation-markdown|^chatgpt-code-block|^chatgpt-math|^conversation-source|^chatgpt-sources-message|^messages$"
    },
    {
      "module": "conversation",
      "subdir": "pages",
      "pattern": "conversation|^local-environment-workflow-messages|^hotkey-window-thread-page|^hotkey-window-new-thread-page|^unrestored-thread-tab-route|^share-conversation-action|^use-resume-conversation-if-needed"
    },
    {
      "module": "app-shell",
      "subdir": "chrome",
      "pattern": "^thread-app-shell-chrome|^app-shell|^window-|^titlebar|^traffic-light"
    },
    {
      "module": "app-shell",
      "subdir": "routing",
      "pattern": "^router|^route|^tab-content|^tabs-|-route$"
    },
    {
      "module": "app-shell",
      "subdir": "layout",
      "pattern": "^layout-|^global-|^command-menu|^toaster|^modal-|^dialog"
    }
  ],
  "path_rules": [
    {
      "prefix": ".vite/build/",
      "module": "main-process",
      "subdir": "build",
      "note": "Electron main process + preload bundles emitted by electron-forge/vite"
    },
    {
      "prefix": "native-menu-locales/",
      "module": "main-process",
      "subdir": "native-menu-locales",
      "note": "Native application menu label localisation tables"
    }
  ],
  "asset_prefix": "webview/assets/",
  "seed_size_limit": 3000000
}
